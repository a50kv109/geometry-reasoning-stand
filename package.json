{
  "name": "geometry-reasoning-stand",
  "version": "1.0.0",
  "description": "Deterministic geometry learning and reasoning verification stand for humans and AI agents.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
